# Python bytecode
__pycache__/
*.pyc

# Logs and scratch files from running the tools
*.log
*.tmp
*.tmp.npz
*.joining


# FaceRecognizer.exe build (build_app.bat)
face-recognizer/build/
face-recognizer/FaceRecognizer.exe

# AdaFace: evaluation only, made locally by tools/get_adaface.py (not shipped)
face-recognizer/models/adaface_ir101_webface12m.onnx
face-recognizer/models/adaface_src/
# YuNet with any input size (GPU face finding): made by tools/get_yunet_dynamic.py, downloaded by fetch_models.py
face-recognizer/models/face_detection_yunet_2023mar_dynamic.onnx

# fetch_models.py partial downloads, and its note of model files already checked (size, time, SHA-256)
*.download
face-recognizer/models/.verified.json

# labels.json copies from each labeling-tool start: a local safety net only. data/ is never in git, so back it up
# yourself (covered by the data/ rule below too)
face-recognizer/data/backups/

# Built-in photo describer (florence.py): 0.8 GB, downloaded on request from Hugging Face
face-recognizer/models/florence2/

# Everything the tools learn from your photos stays on this computer: faces, names, labels, benchmarks
face-recognizer/data/

# The Python environment setup.sh makes (macOS, Linux)
face-recognizer/.venv/
